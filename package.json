{
  "name": "minimal-perp-quant-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "demo": "node --experimental-strip-types src/interview-demo.ts",
    "validate:perp": "node --experimental-strip-types src/perp-execution-validation.ts",
    "validate:perp:testnet": "node --env-file-if-exists=.env --experimental-strip-types --import ./src/binance-testnet-clock-bootstrap.ts src/perp-testnet-validation.ts",
    "smoke:closure": "node --env-file-if-exists=.env --experimental-strip-types --import ./src/binance-testnet-clock-bootstrap.ts src/closure-smoke.ts",
    "testnet:market": "node --experimental-strip-types src/testnet-market-smoke.ts",
    "testnet": "node --env-file-if-exists=.env --experimental-strip-types --import ./src/binance-testnet-clock-bootstrap.ts src/testnet-index.ts",
    "acquire:formal-case-1": "bash scripts/acquire-formal-case-1.sh",
    "overlay": "node --experimental-strip-types src/overlay-index.ts",
    "prospective:discover": "node --experimental-strip-types src/overlay/prospective-discovery.ts",
    "manifest:check": "node --experimental-strip-types src/overlay/prospective-manifest.ts",
    "strategy-lab:replay": "node --env-file-if-exists=.env --experimental-strip-types src/overlay/prospective-runner.ts",
    "prospective:outcome": "node --experimental-strip-types src/overlay/prospective-outcome.ts",
    "price-target:manifest": "node --experimental-strip-types src/overlay/price-target-admission.ts",
    "price-target:collect": "node --experimental-strip-types src/overlay/price-target-collector.ts",
    "price-target:watch": "node --experimental-strip-types src/overlay/price-target-collector.ts --watch",
    "smoke:prediction:prospective": "node --experimental-strip-types src/overlay/prospective-paper-smoke.ts",
    "smoke:prediction:testnet": "node --env-file-if-exists=.env --experimental-strip-types --import ./src/binance-testnet-clock-bootstrap.ts src/overlay/prospective-testnet-demo.ts",
    "replay": "node --experimental-strip-types src/replay-index.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@binance/derivatives-trading-usds-futures": "^38.1.1"
  }
}
