# Binance Futures Testnet only. Do not use production credentials here.
# Copy this file to .env, fill in the values, and never commit .env.
BINANCE_TESTNET_API_KEY=replace_with_binance_futures_testnet_api_key
BINANCE_TESTNET_API_SECRET=replace_with_binance_futures_testnet_api_secret

# Real Laya sidecar used by the joint closure smoke.
LAYA_BASE_URL=http://127.0.0.1:8000

# Optional: only uncomment when the Laya sidecar requires authentication.
# LAYA_API_KEY=replace_with_laya_api_key
